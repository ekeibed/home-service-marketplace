# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
#
# Never commit the real .env — it is already listed in .gitignore.

# ─── Django ─────────────────────────────────────────────────────
# Generate a fresh random key for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# Set DEBUG=False in production. Use True only on your own machine.
DEBUG=True

# Comma-separated list of hostnames the Django app will answer to.
# In production, add your real domain (e.g. homefix.example.com).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins the frontend is served from.
# In production, set this to your real frontend URL (https).
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── PostgreSQL ─────────────────────────────────────────────────
# These must match the values in database/.env (same container).
POSTGRES_DB=home_service_db
POSTGRES_USER=homefix
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DB_HOST=localhost
