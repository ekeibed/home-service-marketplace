# ==========================================
# .env template - copy this to .env and fill in values
# ==========================================
# Run: cp .env.example .env (Mac/Linux)
# Or:  Copy-Item .env.example .env (Windows PowerShell)

POSTGRES_USER=your_username_here
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=your_database_name_here
POSTGRES_PORT=5432